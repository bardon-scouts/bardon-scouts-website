{
  "enabledPlugins": {
    "lvlup-workflow@lvlup-labs": true,
    "dart-flutter@dart-flutter": false,
    "productivity@synced": false,
    "engineering@synced": false
  },
  "extraKnownMarketplaces": {
    "lvlup-labs": {
      "source": {
        "source": "github",
        "repo": "lvlup-labs/lvlup-workflow"
      },
      "autoUpdate": true
    }
  },
  "permissions": {
    "allow": [
      "Edit(/content/**)",
      "Edit(/layouts/**)",
      "Edit(/assets/**)",
      "Edit(/config/**)",
      "Edit(/static/**)",
      "Edit(/data/**)",
      "Edit(/docs/**)"
    ]
  }
}
